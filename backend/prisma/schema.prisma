// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Admin
  Employee
}

enum Status {
  Active
  Inactive
}

enum Theme {
  light
  dark
}

enum DepartmentStatus {
  Active
  Inactive
}

enum DesignationStatus {
  Active
  Inactive
}

model Department {
  id          String           @id @default(cuid())
  name        String           @unique
  code        String           @unique
  description String?
  status      DepartmentStatus @default(Active)

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

model Designation {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  status      DesignationStatus @default(Active)

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("designations")
}

model Employee {
  id String @id @default(cuid())

  employeeId String @unique

  fullName String
  emailID  String @unique
  password String

  passwordResetToken   String?
  passwordResetExpires DateTime?

  refreshTokenHash    String?
  refreshTokenExpires DateTime?

  role   Role   @default(Employee)
  status Status @default(Active)
  theme  Theme  @default(light)

  dateOfBirth DateTime?
  joiningDate DateTime  @default(now())

  phoneNumber String?
  address     String?

  salary Float? @default(0)

  skills               String[] @default([])
  profileImageUrl      String?
  profileImagePublicId String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)

  managerId String?
  manager   Employee? @relation("ManagementHierarchy", fields: [managerId], references: [id], onDelete: SetNull)

  subordinates Employee[] @relation("ManagementHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}
